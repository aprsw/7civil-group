# Copy to .env and adjust as needed. All values have sensible defaults so the
# app runs with zero configuration on SQLite.

APP_DEBUG=true
CORS_ORIGINS=*

# JWT signing secret — CHANGE THIS in production.
JWT_SECRET=change-me-to-a-long-random-string

# Database driver: 'sqlite' (default, zero-config), 'mysql', 'sqlsrv'
# (Microsoft SQL Server 2008+ via pdo_sqlsrv) or 'dblib' (SQL Server via
# FreeTDS, for connecting from Linux with a SQL login).
DB_DRIVER=sqlite

# ── MySQL (DB_DRIVER=mysql) ────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=civil7_automation
DB_USER=root
DB_PASS=

# ── SQL Server (DB_DRIVER=sqlsrv) ──────────────────────────────────────────
# Reuses the DB_* variables above; the default port is 1433. Create the
# database yourself first (the installer only creates tables inside it):
#
#   CREATE DATABASE civil7_automation COLLATE Persian_100_CI_AI;
#
# Windows Authentication (the default): leave DB_USER/DB_PASS empty. The
# connection is then made as the process identity — the IIS application pool
# account for web requests, the signed-in user for `php bin/console` — so that
# account needs rights on the database. Set DB_WINDOWS_AUTH=false and fill in
# DB_USER/DB_PASS to use a SQL login instead.
#
# DB_DRIVER=sqlsrv
# DB_HOST=127.0.0.1
# DB_PORT=1433
# DB_NAME=civil7_automation
# DB_WINDOWS_AUTH=true
# DB_TRUST_CERT=true      # trust a self-signed certificate (local instances)
# DB_ENCRYPT=             # force ('1') or disable ('0') encryption
