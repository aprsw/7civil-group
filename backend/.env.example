# Copy to .env and adjust as needed. All values have sensible defaults so the
# app runs with zero configuration on SQLite.

APP_DEBUG=true
CORS_ORIGINS=*

# JWT signing secret — CHANGE THIS in production.
JWT_SECRET=change-me-to-a-long-random-string

# Database: 'sqlite' (default, zero-config) or 'mysql'
DB_DRIVER=sqlite

# MySQL settings (only used when DB_DRIVER=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=civil7_automation
DB_USER=root
DB_PASS=
