<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS counterpart of the .htaccess beside it: this tree holds uploaded
     files, so no handler may execute anything in it. -->
<configuration>
  <system.webServer>
    <handlers accessPolicy="Read" />
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
