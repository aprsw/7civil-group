#!/usr/bin/env php
<?php

declare(strict_types=1);

use SevenCivilGroup\Core\Autoloader;
use SevenCivilGroup\Core\Config;
use SevenCivilGroup\Infrastructure\Database\Connection;
use SevenCivilGroup\Infrastructure\Database\Migrator;
use SevenCivilGroup\Infrastructure\Database\Seeder;

/**
 * Tiny CLI: `php bin/console migrate|migrate:fresh|seed|install`.
 */

require __DIR__ . '/../src/Core/Autoloader.php';
(new Autoloader())->addNamespace('SevenCivilGroup', __DIR__ . '/../src')->register();

\SevenCivilGroup\Core\Env::load(__DIR__ . '/../.env');
date_default_timezone_set($_ENV['APP_TIMEZONE'] ?? getenv('APP_TIMEZONE') ?: 'Asia/Tehran');

$command = $argv[1] ?? 'help';
$config = Config::fromFile(__DIR__ . '/../config/config.php');
$connection = new Connection($config);
$migrator = new Migrator($connection);
$seeder = new Seeder($connection);

$line = static fn (string $msg) => fwrite(STDOUT, $msg . PHP_EOL);

try {
    switch ($command) {
        case 'migrate':
            $migrator->migrate();
            $line('✓ جداول ساخته شدند.');
            break;

        case 'migrate:fresh':
            $migrator->fresh();
            $line('✓ جداول بازسازی شدند.');
            break;

        case 'seed':
            $seeder->run();
            $line('✓ داده‌های نمونه بارگذاری شدند.');
            break;

        case 'install':
            $migrator->fresh();
            $seeder->run();
            // Write the same lock the web installer writes, so public/install.php
            // refuses to re-run (and wipe this database) on a CLI-installed
            // deployment. Delete it deliberately to re-install.
            $storage = __DIR__ . '/../storage';
            if (!is_dir($storage)) {
                @mkdir($storage, 0775, true);
            }
            @file_put_contents($storage . '/installed.lock', 'installed at ' . date('c') . PHP_EOL);
            $line('✓ نصب کامل شد: جداول ساخته و داده‌های نمونه بارگذاری شدند.');
            $line('  کاربر نمونه: milad.heydari / password');
            $line('  ⚠ اگر فایل public/install.php را روی سرور دارید، حذفش کنید.');
            break;

        default:
            $line('دستورهای موجود: migrate | migrate:fresh | seed | install');
    }
} catch (\Throwable $e) {
    fwrite(STDERR, '✗ خطا: ' . $e->getMessage() . PHP_EOL);
    exit(1);
}
